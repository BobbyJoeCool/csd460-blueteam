<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">
  <display-name>Moffat Bay Marina</display-name>

  <!-- One locale for every <fmt:formatNumber type="currency"> and
       <fmt:formatDate> on the site, so money always shows as US dollars and
       dates as "Jun 1, 2026" no matter what machine Tomcat runs on. -->
  <context-param>
    <param-name>jakarta.servlet.jsp.jstl.fmt.locale</param-name>
    <param-value>en_US</param-value>
  </context-param>

  <!-- No <secure> here on purpose: Tomcat already marks the session cookie
       Secure whenever the request came in over HTTPS, and forcing it on
       would break sign-in on the class server, which runs plain HTTP.
       (Behind a proxy that handles HTTPS, set up Tomcat's RemoteIpValve so
       requests still count as secure.) -->
  <session-config>
    <session-timeout>30</session-timeout>
    <cookie-config>
      <http-only>true</http-only>
    </cookie-config>
    <!-- Cookie only. Otherwise, on a visitor's first page (before Tomcat
         knows the browser takes cookies), every encoded link carries
         ";jsessionid=..." in its address, which leaks the session id into
         copied links, history and Referer headers. -->
    <tracking-mode>COOKIE</tracking-mode>
  </session-config>

  <!-- Security headers on every response, using the filter that ships with
       Tomcat (no code of ours). X-Frame-Options: DENY stops another site
       loading our pages in an invisible frame and tricking a click onto a
       button like "Yes, Cancel It"; X-Content-Type-Options: nosniff stops a
       browser second-guessing a file's type. HSTS is on, but Tomcat only
       sends it on HTTPS responses, so it does nothing on the class server
       and switches itself on once the site is served over HTTPS.
       Content-Security-Policy and Referrer-Policy come from
       SecurityHeadersFilter. Cache-Control: no-store for signed-in pages is
       set separately, by NoStoreFilter, so shared CSS, JS and images can
       still be cached. -->
  <filter>
    <filter-name>httpHeaderSecurity</filter-name>
    <filter-class>org.apache.catalina.filters.HttpHeaderSecurityFilter</filter-class>
    <init-param>
      <param-name>antiClickJackingEnabled</param-name>
      <param-value>true</param-value>
    </init-param>
    <init-param>
      <param-name>antiClickJackingOption</param-name>
      <param-value>DENY</param-value>
    </init-param>
    <init-param>
      <param-name>blockContentTypeSniffingEnabled</param-name>
      <param-value>true</param-value>
    </init-param>
    <init-param>
      <param-name>hstsEnabled</param-name>
      <param-value>true</param-value>
    </init-param>
  </filter>
  <filter-mapping>
    <filter-name>httpHeaderSecurity</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>

  <!-- No error code: this is the catch-all, so a 400, 403 or 405 gets the
       site's own error page instead of Tomcat's grey one (which also shows
       the Tomcat version). error.jsp picks its wording from the status. -->
  <error-page>
    <location>/error.jsp</location>
  </error-page>

  <error-page>
    <exception-type>java.lang.Throwable</exception-type>
    <location>/error.jsp</location>
  </error-page>

</web-app>
